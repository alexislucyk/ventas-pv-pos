# ============================================================
# PLANTILLA de Configuración de Entorno — POS / LS-POS-PRO
# ============================================================
# Copiar este archivo como ".env" y reemplazar los valores.
# NUNCA subir .env al repositorio (está en .gitignore).

# --- Base de Datos ---
DB_HOST=192.168.7.45
DB_NAME=pos_dev
DB_USER=root
DB_PASS=cambiar_esta_contrasena
DB_CHARSET=utf8mb4

# --- Licencia / App Engine ---
APP_VERSION=2.8.0
LICENCIA_KEY=LS-POS-PRO-2024-XXXX-XXXX
LICENCIA_SERVER_IP=190.100.100.50

# --- API Tokens (Consignaciones Remotas) ---
# Generar con: php -r "echo bin2hex(random_bytes(32));"
API_CONSIGNACIONES_TOKEN=generar_un_token_secreto

# --- CORS para APIs públicas ---
# Lista separada por comas de orígenes permitidos
API_CORS_ORIGIN=https://tu-dominio.com.ar
