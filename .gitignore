# Dependencias
vendor/
node_modules/

# Archivos de backup (no subir al repositorio)
backups/
*.sql
# Excepción: las migraciones propias del sistema SÍ van al repo
!migrations/
!migrations/*.sql

# Archivos de configuración sensibles
config/.licencia_ip.conf
config/.licencia_last_success

# Archivos de cache
cache/*.json
cache/ultimo_backup.txt

# Cache de phpqrcode (máscaras QR generadas en runtime, ~450 archivos)
libs/phpqrcode/cache/
libs/phpqrcode/*/cache/

# Archivos temporales
*.tmp
*.log
temp/

# Archivos de backup
index_backup_dashboard.php
test_router.php
test_dbconfig_detection.php

# Sistema operativo
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Laragon (si aplica)
laragon/

# Variables de entorno (credenciales, tokens, versiones)
# IMPORTANTE: .env contiene secretos, NUNCA subir al repositorio.
# .env.example SÍ se sube como plantilla de referencia.
.env
!.env.example